{
  "compilerOptions": {
    "target": "ES2023", "module": "NodeNext", "moduleResolution": "NodeNext",
    "strict": true, "noUncheckedIndexedAccess": true, "noUnusedLocals": true,
    "noUnusedParameters": true, "verbatimModuleSyntax": true,
    "outDir": "dist", "rootDir": ".", "skipLibCheck": true,
    "sourceMap": true, "types": ["node"]
  },
  "include": ["src/**/*.ts", "convex/**/*.ts", "tests/**/*.ts"]
}
